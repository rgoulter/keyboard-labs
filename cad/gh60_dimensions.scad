// GH60 reference dimensions - tenths (0.1mil)
// as in scripts/kicad_helpers/gh60_dimensions.py
//
// 1 tenth = 0.00254 mm

TENTHS_TO_MM = 0.00254;

BOARD_WIDTH_TENTHS  = 112205; // ~285.0 mm
BOARD_HEIGHT_TENTHS =  37244;  // ~94.6 mm
BOARD_W = BOARD_WIDTH_TENTHS * TENTHS_TO_MM;  // 285.0007
BOARD_H = BOARD_HEIGHT_TENTHS * TENTHS_TO_MM; // 94.59976

// Mounts H1-H4 (tenths, top-left origin)
H1_TENTHS = [9921, 10984];
H2_TENTHS = [102382, 10984]; // BOARD_WIDTH_TENTHS - 9823
H3_TENTHS = [50472, 18504];
H4_TENTHS = [75000, 33543];

H_TENTHS = [H1_TENTHS, H2_TENTHS, H3_TENTHS, H4_TENTHS];
H = [ for (p=H_TENTHS) [p[0]*TENTHS_TO_MM, p[1]*TENTHS_TO_MM] ];

// Half-hole edge cutouts
SLOTTED_HOLE_Y_TENTHS = 22244;
SLOTTED_HOLE_Y = SLOTTED_HOLE_Y_TENTHS * TENTHS_TO_MM;
HALF_HOLE_Y_TENTHS = SLOTTED_HOLE_Y_TENTHS;
HALF_HOLE_Y = HALF_HOLE_Y_TENTHS * TENTHS_TO_MM;
HALF_HOLE_X = 3.7;
HALF_HOLE_R = 2.25;
