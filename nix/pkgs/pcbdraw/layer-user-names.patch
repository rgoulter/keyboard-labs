+def _plot_file_suffix(layer_name: str) -> str:
+    """Return the file name suffix kicad-cli uses for a layer in multi mode.
+
+    kicad-cli names each file after the layer's user name, or its standard
+    name when it has none, and replaces characters that are not allowed in
+    Windows file names, ``%`` and ``.`` with ``_``.
+    """
+    return re.sub(r'[*?\\/:"<>|%.]', "_", layer_name.strip())
+
