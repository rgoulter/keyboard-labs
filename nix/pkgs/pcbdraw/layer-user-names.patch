+BOARD_WITH_LAYER_USER_NAMES = '''
+(kicad_pcb
+	(layers
+		(0 "F.Cu" signal "Front")
+		(2 "B.Cu" signal "Back")
+		(5 "F.SilkS" user "F.Silkscreen")
+		(25 "Edge.Cuts" user)
+		(39 "User.1" user "Notes: v1.0")
+	)
+	(footprint "Resistor_SMD:R_0603"
+		(pad "1" smd rect (layers "F.Cu" "F.Mask"))
+	)
+)
+'''
+
+
+def test_board_layer_user_names_reads_board_layer_table():
+    # Assemble: a board with user-named layers, an unnamed layer and a pad
+    document = BOARD_WITH_LAYER_USER_NAMES
+
+    # Act: read the user names from the layer table
+    user_names = board_layer_user_names(document)
+
+    # Assert: only the named layers appear, and the pad is ignored
+    assert user_names == {
+        "F.Cu": "Front",
+        "B.Cu": "Back",
+        "F.SilkS": "F.Silkscreen",
+        "User.1": "Notes: v1.0",
+    }
+
+
+def test_pcb_svg_export_finds_layers_with_user_names(monkeypatch, tmp_path):
+    # Assemble: a fake kicad-cli that names files the way kicad-cli does
+    def fake_run(arguments, **kwargs):
+        output = kicad_cli.Path(arguments[arguments.index("-o") + 1])
+        for name in ("Front", "Back", "F_Silkscreen", "Edge_Cuts", "Notes_ v1_0"):
+            (output / f"board-{name}.svg").write_bytes(name.encode())
+        return b""
+
+    monkeypatch.setattr(kicad_cli, "_kicad_version", lambda executable: (10, 0, 0))
+    monkeypatch.setattr(kicad_cli, "run_kicad_cli", fake_run)
+    board = tmp_path / "board.kicad_pcb"
+    board.write_text(BOARD_WITH_LAYER_USER_NAMES, encoding="utf-8")
+
+    layers = ("F.Cu", "B.Cu", "F.Silkscreen", "Edge.Cuts", "User.1")
+
+    # Act: export the layers by their standard names
+    exported = kicad_cli._export_svg_layers("kicad-cli", str(board), 0, 0, layers)
+
+    # Assert: each layer gets the file named after its user name, if any
+    assert exported == (
+        ("F.Cu", b"Front"),
+        ("B.Cu", b"Back"),
+        ("F.Silkscreen", b"F_Silkscreen"),
+        ("Edge.Cuts", b"Edge_Cuts"),
+        ("User.1", b"Notes_ v1_0"),
+    )
+
