diff --git a/pcbdraw/kicad_sexpr.py b/pcbdraw/kicad_sexpr.py
index 9d92e14..de6363e 100644
--- a/pcbdraw/kicad_sexpr.py
+++ b/pcbdraw/kicad_sexpr.py
@@ -15,6 +15,28 @@ _POINT_RE = re.compile(
 )
 
 
+# The board's layer table: a ``layers`` form whose children are all numbered
+# layer entries.  Group 1 holds the entries.  It matches
+#   (layers (0 "F.Cu" signal "Front") (2 "B.Cu" signal))
+# but not a pad's layer list, whose children are quoted names:
+#   (layers "F.Cu" "F.Mask")
+_BOARD_LAYER_TABLE_RE = re.compile(
+    r'\(layers((?:\s*\(\s*\d+\s+"(?:\\.|[^"\\])*"\s+[\w.]+'
+    r'(?:\s+"(?:\\.|[^"\\])*")?\s*\))+)\s*\)'
+)
+# One entry of the board's layer table: a layer number, the layer name, the
+# layer type, and an optional user name.  Group 1 holds the layer name and
+# group 2 the user name, or an empty string when there is none.  It matches
+#   (0 "F.Cu" signal "Front")   -> "F.Cu", "Front"
+#   (25 "Edge.Cuts" user)       -> "Edge.Cuts", ""
+# but not a pad's layer list:
+#   (layers "F.Cu" "F.Mask")
+_BOARD_LAYER_RE = re.compile(
+    r'\(\s*\d+\s+"((?:\\.|[^"\\])*)"\s+[\w.]+'
+    r'(?:\s+"((?:\\.|[^"\\])*)")?\s*\)'
+)
+
+
 def _forms_with_spans(document: str, form_name: str) -> List[Tuple[int, int]]:
     """Return spans for matching forms at any nesting depth."""
     stack: List[Tuple[int, Optional[str]]] = []
@@ -247,3 +269,26 @@ def normalize_embedded_footprint(document: str) -> str:
         document = re.sub(r"\(justify\s+([^)]+)\)", remove_mirror, document)
 
     return _hide_fields(document)
+
+
+def _unescape(value: str) -> str:
+    return re.sub(r'\\(["\\])', r'\1', value)
+
+
+def board_layer_user_names(document: str) -> Dict[str, str]:
+    """Return user-defined layer names from a board's layer table.
+
+    The result maps the layer name stored in the file (for example ``F.Cu``)
+    to its user name (for example ``Front``).  Layers without a user name are
+    omitted.  Footprint pads also contain ``layers`` forms, but they list
+    quoted names only, so the first form with numbered entries is the board's
+    layer table.
+    """
+    table = _BOARD_LAYER_TABLE_RE.search(document)
+    if table is None:
+        return {}
+    return {
+        _unescape(name): _unescape(user_name)
+        for name, user_name in _BOARD_LAYER_RE.findall(table.group(1))
+        if user_name
+    }
